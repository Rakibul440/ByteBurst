{
  "compilerOptions": {
    "module": "NodeNext", // ✅ ESM for Node
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
